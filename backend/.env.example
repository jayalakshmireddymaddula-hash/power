# ==============================================================================
# FlowPilot AI — Backend Server Environment Configuration (backend/.env.example)
# ==============================================================================
# PRIVILEGED SERVER SECRETS ONLY. Never commit or expose to client browsers.

# 1. Server Runtime & Network
NODE_ENV=development
APP_NAME="FlowPilot AI"
API_PORT=3000
API_URL=http://localhost:3000
APP_URL=http://localhost:5173
LOG_LEVEL=info

# 2. Supabase Database & Service Integration
# Obtain from Supabase Dashboard: Project Settings -> API & Project Settings -> Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
SUPABASE_STORAGE_BUCKET=flowpilot-private-documents

# 3. Database Connection Mode
# When connecting to Supabase PostgreSQL, set DATABASE_TYPE=postgres and supply DATABASE_URL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# When DATABASE_URL is empty, FlowPilot AI automatically uses local durable SQLite (data/flowpilot.db)
DATABASE_TYPE=sqlite
DATABASE_URL=

# 4. Google Gemini AI Integration (@google/genai SDK)
# Set AI_PROVIDER=gemini and provide GEMINI_API_KEY for live Google GenAI model calls
AI_PROVIDER=demo
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=20

# 5. Authentication & JWT Token Signing
JWT_SECRET=super-secret-jwt-key-flowpilot-ai-2026-production-min32chars!

# 6. Security, CORS & Rate Limiting
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=10485760

# 7. Durable Job Queue Engine
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_MAX_ATTEMPTS=5
QUEUE_LOCK_DURATION_MS=60000

# 8. Demonstration & Seeding Controls
DEMO_MODE=true
ALLOW_DEMO_SEED=true

# 9. Notification / Email Transports
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=notifications@flowpilot.ai
