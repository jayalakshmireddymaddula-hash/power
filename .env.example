# FlowPilot AI - Environment Configuration

# Application
NODE_ENV=development
APP_NAME=FlowPilot AI
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
API_PORT=3000
LOG_LEVEL=info

# Supabase (Optional when DEMO_MODE=true or using local database adapter)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=flowpilot-private-documents

# Google Gemini API
# If GEMINI_API_KEY is not set and DEMO_MODE=true, deterministic local AI provider is used
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=demo
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=20

# Database / Queue
# If DATABASE_URL is not set, a local durable SQLite database (data/flowpilot.db) is used automatically
DATABASE_URL=
DATABASE_TYPE=sqlite
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_MAX_ATTEMPTS=5
QUEUE_LOCK_DURATION_MS=60000

# Security
JWT_SECRET=super-secret-jwt-key-flowpilot-ai-2026-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=10485760

# Demo Mode & Seeding
DEMO_MODE=true
ALLOW_DEMO_SEED=true

# Optional Notification/Email Provider
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=notifications@flowpilot.ai
