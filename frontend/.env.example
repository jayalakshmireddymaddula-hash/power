# ==============================================================================
# FlowPilot AI — Frontend Client Environment Configuration (frontend/.env.example)
# ==============================================================================
# All variables exposed to the Vite React browser client MUST begin with VITE_.
# DO NOT include private server secrets (database passwords, private API keys) here.

# 1. Application Identity & Branding
VITE_APP_NAME="FlowPilot AI"
VITE_APP_TAGLINE="Automate the Busywork. Accelerate the Work."
VITE_APP_URL="http://localhost:5173"

# 2. Backend REST API Endpoint
# Default "/api/v1" routes through Vite's local proxy to http://localhost:3000.
# For direct cross-origin access, set to "http://localhost:3000/api/v1".
VITE_API_URL="/api/v1"

# 3. Supabase Integration (Client-Side Auth & Storage)
# Obtain from Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"
VITE_SUPABASE_STORAGE_BUCKET="flowpilot-private-documents"

# 4. Feature Flags & Demo Personas
VITE_ENABLE_DEMO_PERSONAS=true
VITE_ALLOW_DEMO_SEEDING=true

# 5. Localization & Financial Display Defaults
VITE_DEFAULT_CURRENCY="INR"
VITE_CURRENCY_SYMBOL="₹"
VITE_DEFAULT_LOCALE="en-IN"
VITE_ENABLE_DEBUG_LOGS=false
